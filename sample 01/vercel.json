{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/app.py" },
    { "source": "/health", "destination": "/app.py" },
    { "source": "/(.*)", "destination": "/app.py" }
  ],
  "functions": {
    "app.py": {
      "maxDuration": 60
    }
  }
}
